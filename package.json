{
  "name": "@halix/action-sdk",
  "version": "1.0.57",
  "description": "Halix Platform action SDK",
  "types": "./lib/cjs/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf ./lib",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p ./tsconfig.esm.json && node ./scripts/write-esm-package.mjs",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:package": "node ./scripts/package-smoke.mjs",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmastrangelo/halixsdk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mmastrangelo/halixsdk/issues"
  },
  "homepage": "https://github.com/mmastrangelo/halixsdk#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.25",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "typedoc": "^0.28.9",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "axios": "^1.2.2",
    "moment": "^2.29.4",
    "rxjs": "^7.5.5"
  }
}
